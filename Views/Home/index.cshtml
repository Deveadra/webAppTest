@model IEnumerable<Post>
@using System.Linq

@{
    var posts = Model?.ToList() ?? new List<Post>();
    var featuredPost = posts.FirstOrDefault();
    var totalComments = posts.Sum(p => p.MainComments?.Count ?? 0);
    var latestPostDate = posts.Any() ? posts.Max(p => p.Created).ToString("MMM dd, yyyy") : "No posts yet";
}

<section class="hero-section">
    <div class="aurora-layer"></div>
    <div class="hero-content">
        <p class="eyebrow">Technical Leadership Showcase</p>
        <h1>From legacy prototype to modern product vision.</h1>
        <p class="hero-subtitle">
            This platform demonstrates production-minded architecture, role-aware workflows, and a polished user experience designed to impress engineering leadership.
        </p>
        <div class="hero-actions">
            <a class="btn btn-gradient" href="#insights">Explore capabilities</a>
            @if (featuredPost is not null)
            {
                <a class="btn btn-outline-light" asp-controller="Home" asp-action="Post" asp-route-id="@featuredPost.Id">Read featured post</a>
            }
        </div>
    </div>
</section>

<section id="insights" class="metrics-grid reveal-on-scroll">
    <article class="metric-card">
        <p>Total Articles</p>
        <h2 data-counter="@posts.Count">@posts.Count</h2>
        <span>Structured content management</span>
    </article>
    <article class="metric-card">
        <p>Main Discussions</p>
        <h2 data-counter="@totalComments">@totalComments</h2>
        <span>Community engagement architecture</span>
    </article>
    <article class="metric-card">
        <p>Latest Delivery</p>
        <h2 class="metric-date">@latestPostDate</h2>
        <span>Continuous iteration mindset</span>
    </article>
</section>

<section class="showcase-grid reveal-on-scroll">
    <article class="showcase-card">
        <h3>System Thinking</h3>
        <p>Clean separation across controllers, repository, and file services keeps change velocity high while containing complexity.</p>
    </article>
    <article class="showcase-card">
        <h3>Leadership Signals</h3>
        <p>Role-based access and collaboration flows reflect real-world decisions expected from technical leads managing risk and delivery.</p>
    </article>
    <article class="showcase-card">
        <h3>Execution Quality</h3>
        <p>Responsive visual language, reusable components, and motion design combine to create a confident product narrative.</p>
    </article>
</section>

<section class="post-feed reveal-on-scroll">
    <div class="section-header">
        <h2>Featured Engineering Stories</h2>
        <p>Every post represents a design decision, implementation detail, or leadership takeaway.</p>
    </div>

    @if (!posts.Any())
    {
        <div class="empty-state">
            <h3>No posts have been published yet.</h3>
            <p>Create your first post in the admin panel to start showcasing the roadmap.</p>
        </div>
    }
    else
    {
        <div class="post-grid">
            @foreach (var post in posts)
            {
                var imagePath = !string.IsNullOrWhiteSpace(post.Image) ? $"/Image/{post.Image}" : "https://images.unsplash.com/photo-1519389950473-47ba0277781c?auto=format&fit=crop&w=1200&q=80";
                var preview = string.IsNullOrWhiteSpace(post.Body)
                    ? "Read the full update to understand architecture, trade-offs, and delivery strategy."
                    : (post.Body.Length > 160 ? post.Body.Substring(0, 160) + "..." : post.Body);

                <a class="post-card" asp-controller="Home" asp-action="Post" asp-route-id="@post.Id">
                    <div class="post-media">
                        <img src="@imagePath" alt="@post.Title" />
                    </div>
                    <div class="post-content">
                        <p class="post-date">@post.Created.ToString("MMM dd, yyyy")</p>
                        <h3>@post.Title</h3>
                        <p>@preview</p>
                        <span class="read-more">Open article →</span>
                    </div>
                </a>
            }
        </div>
    }
</section>
